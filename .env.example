# ============================================================
# Media Agentcy – Konfiguration
# Kopieren nach .env und ausfüllen. Leere Dienste werden ignoriert.
# ============================================================

# ---------- Allgemein ----------
BOT_NAME=MediaBot
ADMIN_NAME=Felix
SERVER_NAME=Felix' Mediaserver
# Deine WhatsApp-Nummer(n) mit Ländervorwahl, ohne + (mehrere mit Komma)
ADMIN_NUMBERS=4917612345678
# approval = Admin muss neue Nummern freischalten | open = jeder darf | ignore = Unbekannte ignorieren
UNKNOWN_USER_POLICY=approval
LOG_LEVEL=info
# DATA_DIR=./data

# ---------- KI-Anbieter ----------
# openrouter | openai | chatgpt | custom
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...
# Modell muss Tool-Calling können. OpenRouter-Modelle: https://openrouter.ai/models?supported_parameters=tools
LLM_MODEL=openai/gpt-4.1-mini
# Optional stärkeres Modell für den Admin-Chat
# LLM_MODEL_ADMIN=anthropic/claude-sonnet-4.5
# LLM_TEMPERATURE=0.4
# Bilder (Screenshots von Fehlermeldungen) ans Modell geben, falls es Vision kann
LLM_VISION=true

# custom = jeder OpenAI-kompatible Endpoint (Ollama, LM Studio, LiteLLM, ...)
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://192.168.188.129:11434/v1
# LLM_MODEL=qwen3:14b

# chatgpt = ChatGPT-Abo per Codex-Login (EXPERIMENTELL, inoffizielle Schnittstelle)
# 1) Auf einem PC: npx @openai/codex login
# 2) ~/.codex/auth.json nach <DATA_DIR>/codex-auth.json kopieren
# LLM_PROVIDER=chatgpt
# LLM_MODEL=gpt-5
# CHATGPT_AUTH_FILE=/data/codex-auth.json

# ---------- Media-Dienste (interne URLs, ohne / am Ende) ----------
JELLYFIN_URL=http://192.168.188.129:8096
JELLYFIN_API_KEY=
# Adresse, die Nutzer im Browser/App verwenden (wird ihnen ggf. genannt)
JELLYFIN_PUBLIC_URL=

PLEX_URL=http://192.168.188.129:32400
PLEX_TOKEN=

# Jellyseerr oder Overseerr
SEERR_URL=http://192.168.188.129:5055
SEERR_API_KEY=
SEERR_PUBLIC_URL=

OMBI_URL=
OMBI_API_KEY=

SONARR_URL=http://192.168.188.129:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.188.129:7878
RADARR_API_KEY=

# ---------- Verhalten ----------
# Max. Medienanfragen pro Nutzer und Tag
REQUESTS_PER_DAY=10

# ---------- Missbrauchsschutz (gilt nicht für Admins, 0 = aus) ----------
# Themenfremde Anfragen (Hausaufgaben, Texte, Code …) in 24 h, bis der Bot für die Person pausiert
OFF_TOPIC_LIMIT=3
# Nachrichten und Tokens pro Nutzer in 24 h
MESSAGES_PER_DAY=60
TOKENS_PER_DAY=500000
# Längere Nachrichten werden vor der KI gekürzt
MAX_MESSAGE_CHARS=1500
# Darf der Bot defekte Dateien selbstständig löschen + neu suchen?
AUTOFIX_REPLACE_FILE=true
AUTOFIX_MAX_REPLACEMENTS_PER_DAY=3
# Admin bei jedem automatischen Ersetzen kurz informieren
ADMIN_NOTIFY_AUTOFIX=true
# Wie oft auf fertige Anfragen / Auto-Fixes prüfen (Minuten)
NOTIFY_POLL_MINUTES=5
# ai = Bot formuliert Benachrichtigungen persönlich | template = feste Texte (spart Tokens)
NOTIFY_STYLE=ai

# ---------- Web-Oberfläche / HTTP ----------
# Alle Einstellungen hier lassen sich auch in der Web-Oberfläche ändern (http://<host>:8080).
# Werte aus der Web-Oberfläche haben Vorrang vor dieser Datei.
HTTP_PORT=8080
# Passwort für die Web-Oberfläche. Leer = beim ersten Start wird ein zufälliges Passwort ins Log geschrieben,
# das du danach in der Oberfläche ändern kannst.
WEB_PASSWORD=
# Schützt /qr und /webhook (…/qr?token=XYZ)
HTTP_TOKEN=

# ---------- Persönlichkeit ----------
# Zusätzliche Anweisungen, die der Bot in jedem Nutzer-Gespräch befolgt (einfacher in der Web-Oberfläche)
PROMPT_EXTRA=

# ---------- Feintuning ----------
# Wartezeit, um mehrere schnelle Nachrichten zu bündeln (ms)
DEBOUNCE_MS=2500
# Anzahl Nachrichten im Kurzzeitgedächtnis
HISTORY_LIMIT=20
# Ab so vielen Nachrichten werden ältere ins Langzeitgedächtnis zusammengefasst
SUMMARIZE_AFTER=40
MAX_TOOL_ROUNDS=8
