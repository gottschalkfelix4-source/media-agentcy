# ============================================================
# Media Agentcy – Konfiguration
# Kopieren nach .env und ausfüllen. Leere Dienste werden ignoriert.
# ============================================================

# ---------- Allgemein ----------
BOT_NAME=MediaBot
ADMIN_NAME=Felix
SERVER_NAME=Felix' Mediaserver
# Deine WhatsApp-Nummer(n) mit Ländervorwahl, ohne + (mehrere mit Komma)
ADMIN_NUMBERS=4917612345678
# approval = Admin muss neue Nummern freischalten | open = jeder darf | ignore = Unbekannte ignorieren
UNKNOWN_USER_POLICY=approval
LOG_LEVEL=info
# DATA_DIR=./data

# ---------- KI-Anbieter ----------
# openrouter | openai | anthropic | chatgpt | grok | custom
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...
# Modell muss Tool-Calling können. OpenRouter-Modelle: https://openrouter.ai/models?supported_parameters=tools
LLM_MODEL=openai/gpt-4.1-mini
# Optional stärkeres Modell für den Admin-Chat
# LLM_MODEL_ADMIN=anthropic/claude-sonnet-4.5
# LLM_TEMPERATURE=0.4
# Bilder (Screenshots von Fehlermeldungen) ans Modell geben, falls es Vision kann
LLM_VISION=true

# anthropic = Claude direkt über die Messages API (API-Key von https://platform.claude.com, nicht das Claude-Abo)
# Leeres LLM_MODEL = claude-opus-5-5. Prompt-Caching ist automatisch an, LLM_TEMPERATURE wird ignoriert.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5

# custom = jeder OpenAI-kompatible Endpoint (Ollama, LM Studio, LiteLLM, ...)
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://192.168.188.129:11434/v1
# LLM_MODEL=qwen3:14b

# chatgpt = ChatGPT-Abo über „Sign in with ChatGPT“ (offizieller OpenAI-Weg für Open-Source-Apps)
# Anmelden in der Web-Oberfläche: Einstellungen → KI-Anbieter → „Continue with ChatGPT“. Kein API-Key nötig.
# Leeres LLM_MODEL = erstes Modell des Kontos. Die Anmeldung liegt in <DATA_DIR>/chatgpt-auth.json.
# LLM_PROVIDER=chatgpt

# grok = Grok-Abo (SuperGrok / X Premium+) über xAIs Anmeldung per Code (OAuth Device Flow)
# Anmelden in der Web-Oberfläche: Einstellungen → KI-Anbieter → Grok-Abo → „Mit Grok anmelden“. Kein API-Key nötig.
# Leeres LLM_MODEL = grok-4.7. Die Anmeldung liegt in <DATA_DIR>/grok-auth.json.
# LLM_PROVIDER=grok

# ---------- Media-Dienste (interne URLs, ohne / am Ende) ----------
JELLYFIN_URL=http://192.168.188.129:8096
JELLYFIN_API_KEY=
# Adresse, die Nutzer im Browser/App verwenden (wird ihnen ggf. genannt)
JELLYFIN_PUBLIC_URL=

PLEX_URL=http://192.168.188.129:32400
PLEX_TOKEN=

# Jellyseerr oder Overseerr
SEERR_URL=http://192.168.188.129:5055
SEERR_API_KEY=
SEERR_PUBLIC_URL=

OMBI_URL=
OMBI_API_KEY=

SONARR_URL=http://192.168.188.129:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.188.129:7878
RADARR_API_KEY=

# ---------- Verhalten ----------
# Max. Medienanfragen pro Nutzer und Tag
REQUESTS_PER_DAY=10
# Vor jeder Anfrage Cover, Titel und Erscheinungsdatum schicken und auf ein Ja warten
REQUEST_CONFIRM=true
# Anfragen, die länger hängen, prüft der Bot selbst, stößt an, was geht, und schickt dir eine Sammelnachricht (0 = aus)
STUCK_REQUEST_DAYS=3

# ---------- Neue Nutzer ----------
# Beim Freischalten automatisch ein Jellyfin-Konto anlegen, nach Jellyseerr übernehmen und Zugangsdaten per WhatsApp schicken
ONBOARD_JELLYFIN=false
# Zusatztext, der an die Nachricht mit Zugangsdaten und App-Anleitung angehängt wird
# ONBOARD_GUIDE=

# ---------- Sprachnachrichten ----------
# OpenAI-kompatibler Whisper-Endpoint. OpenRouter kann das nicht.
# Groq: https://api.groq.com/openai/v1 + whisper-large-v3-turbo | OpenAI: leer lassen bei LLM_PROVIDER=openai, Modell whisper-1
VOICE_ENABLED=false
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=
# STT_MODEL=whisper-large-v3-turbo
# Längere Sprachnachrichten werden nicht umgewandelt (Sekunden, 0 = kein Limit)
VOICE_MAX_SECONDS=120

# ---------- Wochenrückblick ("Neu auf dem Server") ----------
# Feste Nachricht ohne KI an alle aktiven Nutzer, die ihn nicht abbestellt haben. Zeitzone = TZ des Containers.
DIGEST_ENABLED=false
# mo | di | mi | do | fr | sa | so
DIGEST_DAY=fr
DIGEST_HOUR=18

# ---------- Störungen & Wartung ----------
# Jellyfin/Plex regelmäßig anpingen; bei Ausfall bekommen Nutzer einen festen Hinweis statt Tickets
OUTAGE_DETECTION=true

# ---------- Hermes Agent (optional) ----------
# Ernste Probleme an deinen Hermes Agent weitergeben; er meldet sich unter HERMES_CALLBACK_URL/webhook/hermes zurück
# HERMES_WEBHOOK_URL=http://192.168.1.10:8644/webhooks/media-agentcy
# HERMES_WEBHOOK_SECRET=
# Adresse, unter der Hermes diesen Bot erreicht
# HERMES_CALLBACK_URL=http://192.168.1.10:8085
# Eskalierte Tickets ab dieser Schwere automatisch übergeben: low | normal | high | critical
HERMES_MIN_SEVERITY=high
# Erkannte Ausfälle von Jellyfin/Plex ebenfalls übergeben
HERMES_OUTAGES=true
# Erinnern, wenn Hermes sich so viele Stunden nicht meldet (0 = nie)
HERMES_TIMEOUT_HOURS=6

# ---------- Missbrauchsschutz (gilt nicht für Admins, 0 = aus) ----------
# Themenfremde Anfragen (Hausaufgaben, Texte, Code …) in 24 h, bis der Bot für die Person pausiert
OFF_TOPIC_LIMIT=3
# Nachrichten und Tokens pro Nutzer in 24 h
MESSAGES_PER_DAY=60
TOKENS_PER_DAY=500000
# Längere Nachrichten werden vor der KI gekürzt
MAX_MESSAGE_CHARS=1500
# Darf der Bot defekte Dateien selbstständig löschen + neu suchen?
AUTOFIX_REPLACE_FILE=true
AUTOFIX_MAX_REPLACEMENTS_PER_DAY=3
# Admin bei jedem automatischen Ersetzen kurz informieren
ADMIN_NOTIFY_AUTOFIX=true
# Wie oft auf fertige Anfragen / Auto-Fixes prüfen (Minuten)
NOTIFY_POLL_MINUTES=5
# ai = Bot formuliert Benachrichtigungen persönlich | template = feste Texte (spart Tokens)
NOTIFY_STYLE=ai

# ---------- Web-Oberfläche / HTTP ----------
# Alle Einstellungen hier lassen sich auch in der Web-Oberfläche ändern (http://<host>:8080).
# Werte aus der Web-Oberfläche haben Vorrang vor dieser Datei.
HTTP_PORT=8080
# Passwort für die Web-Oberfläche. Leer = beim ersten Start wird ein zufälliges Passwort ins Log geschrieben,
# das du danach in der Oberfläche ändern kannst.
WEB_PASSWORD=
# Schützt /webhook (…/webhook/seerr?token=XYZ). /qr geht ohne Token nur mit Web-Login.
HTTP_TOKEN=
# true, wenn die Oberfläche nur über einen Reverse Proxy erreichbar ist (X-Forwarded-For/-Proto werden dann vertraut)
TRUST_PROXY=false

# ---------- Persönlichkeit ----------
# Zusätzliche Anweisungen, die der Bot in jedem Nutzer-Gespräch befolgt (einfacher in der Web-Oberfläche)
PROMPT_EXTRA=

# ---------- Feintuning ----------
# Wartezeit, um mehrere schnelle Nachrichten zu bündeln (ms)
DEBOUNCE_MS=2500
# Anzahl Nachrichten im Kurzzeitgedächtnis
HISTORY_LIMIT=20
# Ab so vielen Nachrichten werden ältere ins Langzeitgedächtnis zusammengefasst
SUMMARIZE_AFTER=40
MAX_TOOL_ROUNDS=8
