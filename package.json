{
  "name": "media-agentcy",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp AI support agent for Jellyfin/Plex users",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chat": "tsx src/cli/chat.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "1.5",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
