{
  "name": "media-agentcy",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp AI support agent for Jellyfin/Plex users",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "chat": "tsx src/cli/chat.ts",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "baileys": "^7.0.0-rc14",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "qrcode": "1.5",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.4"
  }
}
